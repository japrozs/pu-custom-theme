{% render 'banner' %}
{% render 'topbar', title: '<a href="/" class="back-link"><i class="fa-solid fa-arrow-left" style="margin-right:5px;"></i> ALL PRODUCTS</a>' %}
{% comment %} {% render 'topbar', title: 'PRODUCT LISTING' %} {% endcomment %}
{% comment %} {% render 'topbar', title: product.title %} {% endcomment %}

<div class="product-page">

	<div class="product-images">
    <div class="product-image-main" id="mainImageBox">
        <div class="product-image-box desktop-only">
            <img src="{{ product.images.first | img_url: 'master' }}" alt="{{ product.images.first.alt | escape }}" id="mainImage" />
        </div>
        <button class="carousel-arrow carousel-prev" id="carouselPrev"><i class="fa-solid fa-caret-left"></i></button>
        <button class="carousel-arrow carousel-next" id="carouselNext"><i class="fa-solid fa-caret-right"></i></button>
    </div>

    <div class="product-image-mobile-scroll">
        {% for image in product.images %}
            <div class="product-image-box">
                <img src="{{ image | img_url: 'master' }}" alt="{{ image.alt | escape }}" />
            </div>
        {% endfor %}
    </div>

    <div class="product-image-thumbs" id="productThumbs">
        {% for image in product.images %}
            <div class="thumb-box {% if forloop.first %}active{% endif %}" data-image-url="{{ image | img_url: 'master' }}" data-index="{{ forloop.index0 }}">
                <img src="{{ image | img_url: '200x' }}" alt="{{ image.alt | escape }}" />
            </div>
        {% endfor %}
    </div>
</div>

  {% comment %} <div class="product-images">
    {% for image in product.images %}
      <div class="product-image-box">
        <img src="{{ image | img_url: 'master' }}" alt="{{ image.alt | escape }}" />
      </div>
    {% endfor %}
  </div> {% endcomment %}

  <div class="product-info">
    <h1 class="product-title">"{{ product.title }}"</h1>
    <div class="product-price">{{ product.price | money_without_currency }} USD</div>

    {% assign current_variant = product.selected_or_first_available_variant %}

    {% if product.options contains 'Color' %}
      <div class="product-option">
        <div class="option-label">{{ current_variant.title | upcase }}</div>
        <div class="color-swatches">
          {% for variant in product.variants %}
            <button
              class="color-swatch {% if variant.id == current_variant.id %}active{% endif %} {% unless variant.available %}unavailable{% endunless %}"
              data-variant-id="{{ variant.id }}"
              data-variant-url="{{ product.url }}?variant={{ variant.id }}"
              style="background-color: {{ variant.option1 | downcase | replace: ' ', '' }};"
              title="{{ variant.option1 }}"
            ></button>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if product.options contains 'Size' %}
      <div class="product-option">
        <div class="size-grid">
          {% for variant in product.variants %}
            <button
              class="size-btn {% if variant.id == current_variant.id %}active{% endif %} {% unless variant.available %}unavailable{% endunless %}"
              data-variant-id="{{ variant.id }}"
              data-variant-url="{{ product.url }}?variant={{ variant.id }}"
            >
              {{ variant.option2 | default: variant.option1 }}
            </button>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% comment %} <a href="/pages/size-guide" class="size-guide-link">SIZE GUIDE <i class="fa-solid fa-chevron-right"></i></a> {% endcomment %}
	 <a href="#" class="size-guide-link" id="sizeGuideBtn">SIZE GUIDE <i class="fa-solid fa-chevron-right"></i></a>

<div class="modal-overlay" id="sizeGuideOverlay">
    <div class="modal">
        <div class="modal-header">
            <span>SIZE GUIDE</span>
            <button class="modal-close" id="sizeGuideClose"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="modal-body">
            {{ product.metafields.custom.size_and_fit | metafield_tag }}
        </div>
    </div>
</div>
	 

    <div class="product-actions">
      {% form 'product', product %}
        <input type="hidden" name="id" id="variantId" value="{{ current_variant.id }}" />
        {% if current_variant.available %}
          <button type="submit" class="btn-add-to-cart">ADD TO BAG</button>
        {% else %}
          <button type="button" class="btn-add-to-cart unavailable" disabled>SOLD OUT</button>
        {% endif %}
      {% endform %}
    </div>

    <p class="product-legal">
      I ACCEPT THE <a href="/pages/terms-of-service">GENERAL CONDITIONS OF SALE</a>, AND CONSENT
      TO THE PROCESSING OF MY DATA, IN ACCORDANCE WITH THE
      <a href="/pages/terms-of-service">PRIVACY POLICY</a>.
    </p>

    <div class="product-accordions">
      <div class="accordion">
        <button class="accordion-header">
          DETAILS <i class="fa-solid fa-plus"></i>
        </button>
        <div class="accordion-body">
          {{ product.description }}
        </div>
      </div>
      <div class="accordion">
        <button class="accordion-header">
          CARE AND MAINTENANCE <i class="fa-solid fa-plus"></i>
        </button>
        <div class="accordion-body">
          {{ product.metafields.custom.care_instructions | metafield_tag }}
        </div>
      </div>
      {% comment %} <div class="accordion">
        <button class="accordion-header">
          SIZE AND FIT <i class="fa-solid fa-plus"></i>
        </button>
        <div class="accordion-body">
          {{ product.metafields.custom.size_and_fit | metafield_tag}}
        </div>
      </div> {% endcomment %}
    </div>

    <div class="product-links">
      <a href="/pages/shipping-policy" class="product-link">SHIPPING <i class="fa-solid fa-chevron-right"></i></a>
      <a href="/pages/terms-of-service" class="product-link">RETURNS AND EXCHANGES <i class="fa-solid fa-chevron-right"></i></a>
    </div>

  </div>
</div>