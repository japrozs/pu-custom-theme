{% render 'banner' %}
{% render 'topbar', title: '<a href="/" class="back-link"><i class="fa-solid fa-arrow-left" style="margin-right:5px;"></i> ALL PRODUCTS</a>' %}
{% comment %} {% render 'topbar', title: 'PRODUCT LISTING' %} {% endcomment %}
{% comment %} {% render 'topbar', title: product.title %} {% endcomment %}

<div class="product-page">

  <div class="product-images">
    {% for image in product.images %}
      <div class="product-image-box">
        <img src="{{ image | img_url: 'master' }}" alt="{{ image.alt | escape }}" />
      </div>
    {% endfor %}
  </div>

  <div class="product-info">
    <h1 class="product-title">"{{ product.title }}"</h1>
    <div class="product-price">{{ product.price | money_without_currency }} USD</div>

    {% assign current_variant = product.selected_or_first_available_variant %}

    {% if product.options contains 'Color' %}
      <div class="product-option">
        <div class="option-label">{{ current_variant.title | upcase }}</div>
        <div class="color-swatches">
          {% for variant in product.variants %}
            <button
              class="color-swatch {% if variant.id == current_variant.id %}active{% endif %} {% unless variant.available %}unavailable{% endunless %}"
              data-variant-id="{{ variant.id }}"
              data-variant-url="{{ product.url }}?variant={{ variant.id }}"
              style="background-color: {{ variant.option1 | downcase | replace: ' ', '' }};"
              title="{{ variant.option1 }}"
            ></button>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if product.options contains 'Size' %}
      <div class="product-option">
        <div class="size-grid">
          {% for variant in product.variants %}
            <button
              class="size-btn {% if variant.id == current_variant.id %}active{% endif %} {% unless variant.available %}unavailable{% endunless %}"
              data-variant-id="{{ variant.id }}"
              data-variant-url="{{ product.url }}?variant={{ variant.id }}"
            >
              {{ variant.option2 | default: variant.option1 }}
            </button>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <a href="/pages/size-guide" class="size-guide-link">SIZE GUIDE <i class="fa-solid fa-chevron-right"></i></a>

    <div class="product-actions">
      {% form 'product', product %}
        <input type="hidden" name="id" id="variantId" value="{{ current_variant.id }}" />
        {% if current_variant.available %}
          <button type="submit" class="btn-add-to-cart">ADD TO BAG</button>
        {% else %}
          <button type="button" class="btn-add-to-cart unavailable" disabled>SOLD OUT</button>
        {% endif %}
      {% endform %}
    </div>

    <p class="product-legal">
      I ACCEPT THE <a href="/policies/terms-of-service">GENERAL CONDITIONS OF SALE</a>, AND CONSENT
      TO THE PROCESSING OF MY DATA, IN ACCORDANCE WITH THE
      <a href="/policies/privacy-policy">PRIVACY POLICY</a>.
    </p>

    <div class="product-accordions">
      <div class="accordion">
        <button class="accordion-header">
          DETAILS <i class="fa-solid fa-plus"></i>
        </button>
        <div class="accordion-body">
          {{ product.description }}
        </div>
      </div>
      <div class="accordion">
        <button class="accordion-header">
          CARE AND MAINTENANCE <i class="fa-solid fa-plus"></i>
        </button>
        <div class="accordion-body">
          {{ product.metafields.custom.care_instructions }}
        </div>
      </div>
      <div class="accordion">
        <button class="accordion-header">
          SIZE AND FIT <i class="fa-solid fa-plus"></i>
        </button>
        <div class="accordion-body">
          {{ product.metafields.custom.size_and_fit }}
        </div>
      </div>
    </div>

    <div class="product-links">
      <a href="/pages/shipping" class="product-link">SHIPPING <i class="fa-solid fa-chevron-right"></i></a>
      <a href="/policies/refund-policy" class="product-link">RETURNS AND EXCHANGES (WITHIN 14 DAYS) <i class="fa-solid fa-chevron-right"></i></a>
    </div>

  </div>
</div>