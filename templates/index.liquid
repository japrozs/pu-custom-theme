{% assign collection = collections.all %}
{% assign products = collection.products | sort: 'published_at' | reverse %}
<div class="index-page">
{% render 'banner' %}
{% render 'topbar', title: 'ALL PRODUCTS' %}
<div class="products">
  {% for product in products %}
    <div class="card">
      <a href="{{ product.url }}">
        {% comment %} <div class="image-box">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: 'large' }}" alt="{{ product.featured_image.alt | escape }}" />
          {% endif %}
        </div> {% endcomment %}
		<div class="image-box">
			{% if product.featured_image %}
				<img 
					class="product-img-primary"
					src="{{ product.featured_image | img_url: 'large' }}" 
					alt="{{ product.featured_image.alt | escape }}" 
				/>
			{% endif %}
			{% if product.images[1] %}
				<img 
					class="product-img-secondary"
					src="{{ product.images[1] | img_url: 'large' }}" 
					alt="{{ product.images[1].alt | escape }}" 
				/>
			{% endif %}
		</div>
        <div class="product-name">
          {{ product.title }}
          {% unless product.available %}
            <span class="status">[sold out]</span>
          {% endunless %}
        </div>
        <div class="price">{{ product.price | money_without_currency }} USD</div>
      </a>
    </div>
  {% endfor %}
</div>
{% render 'bottom-banner' %}
</div>