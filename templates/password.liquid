<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
{% comment %} <meta name="theme-color" content="#ff1b4d"> {% endcomment %}
{% layout 'password' %}
<div class="password-page">
  <div class="password-logo">
    <img src="https://cdn.shopify.com/s/files/1/0968/9579/5505/files/pu-logo-chrome.png?v=1781240595" alt="{{ shop.name }}" />
    {% comment %} <img src="https://cdn.shopify.com/s/files/1/0968/9579/5505/files/logo-text.png?v=1778470618" alt="{{ shop.name }}" /> {% endcomment %}
  </div>
  {%- assign countdown_target = '2026-07-30T12:00:00-05:00' -%}
  <div class="countdown-timer" data-countdown-target="{{ countdown_target | escape }}">
    <span class="countdown-value">--<span class="countdown-letter">d</span> --<span class="countdown-letter">h</span> --<span class="countdown-letter">m</span> --<span class="countdown-letter">s</span></span>
  </div>
  <div class="password-forms">
    {% form 'customer', id: 'email-form' %}
      <input type="hidden" name="contact[tags]" value="prospect, password page" />
      <div class="password-field">
        <input
          type="email"
          name="contact[email]"
          placeholder="EMAIL"
          class="password-input"
          required
        />
        <button type="submit" class="password-submit">NOTIFY ME</button>
      </div>
    {% endform %}
  </div>
</div>

{% comment %} <button class="lock-btn" id="lockBtn"><i class="fa-solid fa-lock"></i></button> {% endcomment %}
 <div class="enter-pwd-link" id="lockBtn"><i class="fa-solid fa-lock"></i>enter password</div>

<div class="modal-overlay" id="passwordOverlay">
  <div class="modal">
    <div class="modal-header">
      <span>ENTER PASSWORD</span>
      <button class="modal-close" id="passwordClose"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="modal-body">
      {% form 'storefront_password' %}
        <div class="password-field">
          <input
            type="password"
            name="password"
            placeholder="PASSWORD"
            class="password-input"
          />
          <button type="submit" class="password-submit">ENTER</button>
        </div>
        {% if form.errors %}
          <p class="password-error">{{ form.errors | default_errors }}</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

<script>
  (function () {
    var el = document.querySelector('.countdown-timer');
    if (!el || !el.dataset.countdownTarget) return;
    var targetMs = Date.parse(el.dataset.countdownTarget);
    if (Number.isNaN(targetMs)) return;
    var valueEl = el.querySelector('.countdown-value');
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function tick() {
      var diff = targetMs - Date.now();
      if (diff <= 0) {
        valueEl.textContent = 'DROP IS LIVE';
        clearInterval(timer);
        return;
      }
      var totalSeconds = Math.floor(diff / 1000);
      var days  = Math.floor(totalSeconds / 86400);
      var hours = Math.floor((totalSeconds % 86400) / 3600);
      var mins  = Math.floor((totalSeconds % 3600) / 60);
      var secs  = totalSeconds % 60;
      valueEl.innerHTML =
        pad(days)  + '<span class="countdown-letter">d</span> ' +
        pad(hours) + '<span class="countdown-letter">h</span> ' +
        pad(mins)  + '<span class="countdown-letter">m</span> ' +
        pad(secs)  + '<span class="countdown-letter">s</span>';
    }
    tick();
    var timer = setInterval(tick, 1000);
  })();

  var lockBtn = document.getElementById('lockBtn');
  var passwordOverlay = document.getElementById('passwordOverlay');
  var passwordClose = document.getElementById('passwordClose');

  if (lockBtn && passwordOverlay) {
    lockBtn.addEventListener('click', function () {
      passwordOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    });

    passwordClose.addEventListener('click', function () {
      passwordOverlay.classList.remove('active');
      document.body.style.overflow = '';
    });

    passwordOverlay.addEventListener('click', function (e) {
      if (e.target === passwordOverlay) {
        passwordOverlay.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  }
</script>