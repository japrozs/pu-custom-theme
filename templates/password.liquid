{% layout 'password' %}

<div class="password-page">

  <div class="password-logo">
  <img src="https://cdn.shopify.com/s/files/1/0968/9579/5505/files/logo-text.png?v=1778470618" alt="{{ shop.name }}" />
</div>

  {%- assign countdown_target = '2026-05-31T12:00:00-05:00' -%}
  <div class="countdown-timer" data-countdown-target="{{ countdown_target | escape }}">
    <span class="countdown-value">--<span class="countdown-letter">d</span> --<span class="countdown-letter">h</span> --<span class="countdown-letter">m</span> --<span class="countdown-letter">s</span></span>
  </div>

  <div class="password-forms">

    {% form 'customer', id: 'email-form' %}
      <input type="hidden" name="contact[tags]" value="prospect, password page" />
      <div class="password-field">
        <input
          type="email"
          name="contact[email]"
          placeholder="EMAIL"
          class="password-input"
          required
        />
        <button type="submit" class="password-submit">NOTIFY ME</button>
      </div>
    {% endform %}

    <div class="password-divider">
      <span>OR</span>
    </div>

    {% form 'storefront_password' %}
      <div class="password-field">
        <input
          type="password"
          name="password"
          placeholder="PASSWORD"
          class="password-input"
        />
        <button type="submit" class="password-submit">ENTER</button>
      </div>
    {% endform %}

  </div>

</div>

<script>
  (function () {
    var el = document.querySelector('.countdown-timer');
    if (!el || !el.dataset.countdownTarget) return;

    var targetMs = Date.parse(el.dataset.countdownTarget);
    if (Number.isNaN(targetMs)) return;

    var valueEl = el.querySelector('.countdown-value');

    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function tick() {
      var diff = targetMs - Date.now();
      if (diff <= 0) {
        valueEl.textContent = 'drop is live rn';
        clearInterval(timer);
        return;
      }
      var totalSeconds = Math.floor(diff / 1000);
      var days  = Math.floor(totalSeconds / 86400);
      var hours = Math.floor((totalSeconds % 86400) / 3600);
      var mins  = Math.floor((totalSeconds % 3600) / 60);
      var secs  = totalSeconds % 60;

      valueEl.innerHTML =
        pad(days)  + '<span class="countdown-letter">d</span> ' +
        pad(hours) + '<span class="countdown-letter">h</span> ' +
        pad(mins)  + '<span class="countdown-letter">m</span> ' +
        pad(secs)  + '<span class="countdown-letter">s</span>';
    }

    tick();
    var timer = setInterval(tick, 1000);
  })();
</script>