{% comment %} {% render 'banner' %} {% endcomment %}
{% comment %} {% render 'topbar', title: 'SHIPPING POLICY' %} {% endcomment %}
<div>
    <div class="policy-page">
		<div class="policy-last-updated menlo">NO MAN IS AN ISLAND, ENTIRE OF ITSELF...</div>
        <div class="policy-item">
            <span class="policy-key">Shipping Origin</span>
            <span class="policy-value">All orders ship from Atlanta, USA.</span>
        </div>
        <div class="policy-item">
            <span class="policy-key">Processing Time</span>
            <span class="policy-value">Orders are processed and dispatched within 1–3 working days, excluding pre-orders.</span>
        </div>
        <div class="policy-item">
            <span class="policy-key">Shipping Rates</span>
            <span class="policy-value">Calculated at checkout based on your location.</span>
        </div>
        <div class="policy-item">
            <span class="policy-key">Worldwide Shipping</span>
            <span class="policy-value">We ship worldwide. Delivery times vary by destination and carrier.</span>
        </div>
        <div class="policy-item">
            <span class="policy-key">Customs & Duties</span>
            <span class="policy-value">International customers are responsible for any customs duties, import taxes, and related fees. We can't control or predict these charges.</span>
        </div>
        <div class="policy-item">
            <span class="policy-key">Pre-Orders</span>
            <span class="policy-value">Pre-order items ship on the date listed on the product page. If your order includes both pre-order and in-stock items, it may ship together once the pre-order is ready.</span>
        </div>
        <div class="policy-item">
            <span class="policy-key">Returns & Refunds</span>
            <span class="policy-value">All sales are final. Refunds are only issued if an item arrives defective.</span>
        </div>
        <div class="policy-item">
            <span class="policy-key">Questions</span>
            <span class="policy-value">For any questions regarding your package or shipment, send a dm to <a href="https://instagram.com/primaryunion" class="menlo red" target="_blank">@primaryunion</a> on ig.</span>
        </div>
		<p class="about-caption red menlo" style="margin-top:15px;">[FUCK THE RULES] <span class="gray" style="margin-left:5px;">[..-. ..- -.-. -.- - .... . .-. ..- .-.. . ...]</span></p>
    </div>
    {% render 'bottom-banner' %}
</div>