<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    <link href="https://fonts.cdnfonts.com/css/neue-haas-grotesk-display-pro" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    {{ 'styles.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    <div class="page">

      <!-- DESKTOP SIDEBAR -->
      <aside class="sidebar">
        <div class="logo">
          <a href="/">
            <img src="https://cdn.shopify.com/s/files/1/0968/9579/5505/files/logo-text.png?v=1778470618" alt="{{ shop.name }}" />
          </a>
        </div>
        <nav class="menu">
			<a href="{{ routes.root_url }}" class="sq-1 {% if template.name == 'index' %}active-link{% endif %}">ALL</a>
			<a href="/pages/archive" class="sq-2 {% if page.handle == 'archive' %}active-link{% endif %}">ARCHIVE</a>
			<a href="/pages/manifesto" class="sq-3 {% if page.handle == 'manifesto' %}active-link{% endif %}">MANIFESTO</a>
		</nav>
		<nav class="menu">
			<a href="/blogs/journal" class="sq-4 {% if template.name == 'blog' %}active-link{% endif %}">JOURNAL</a>
			<a href="/pages/about" class="sq-5 {% if page.handle == 'about' %}active-link{% endif %}">ABOUT</a>
			<a href="https://www.instagram.com/" target="_blank" class="sq-6">INSTAGRAM</a>
			<a href="/policies/privacy-policy" class="sq-7 {% if template.name == 'policy' %}active-link{% endif %}">PRIVACY POLICY</a>
		</nav>
        <div class="bottom">
          <img src="https://cdn.shopify.com/s/files/1/0968/9579/5505/files/bootpu.png?v=1778470582" alt="" />
        </div>
      </aside>

      <!-- MOBILE NAVBAR -->
      <header class="mobile-nav">
        <div class="mobile-nav-top">
          <div class="mobile-logo">
            <a href="/">
              <img src="https://cdn.shopify.com/s/files/1/0968/9579/5505/files/logo-text.png?v=1778470618" alt="{{ shop.name }}" />
            </a>
          </div>
          <button class="hamburger" id="hamburger" aria-label="Menu">
            <i class="fa-solid fa-bars"></i>
          </button>
        </div>
        <div class="mobile-nav-bottom">
          <div class="search-wrapper">
            <div class="search-bar">
              <input type="text" placeholder="SEARCH PRODUCTS" class="search-input" id="searchInputMobile" />
              <i class="fa-solid fa-magnifying-glass search-icon"></i>
            </div>
            <div class="search-results" id="searchResultsMobile"></div>
          </div>
          <button class="cart-link cart-toggle">CART [{{ cart.item_count }}]</button>
        </div>
        <nav class="mobile-menu" id="mobileMenu">
			<a href="{{ routes.root_url }}" class="sq-1">ALL</a>
			<a href="/pages/archive" class="sq-2">ARCHIVE</a>
			<a href="/pages/manifesto" class="sq-3">MANIFESTO</a>
			<a href="/blogs/journal" class="sq-4">JOURNAL</a>
			<a href="/pages/about" class="sq-5">ABOUT</a>
			<a href="https://www.instagram.com/" target="_blank" class="sq-6">INSTAGRAM</a>
			<a href="/policies/privacy-policy" class="sq-7">PRIVACY POLICY</a>
		</nav>
      </header>

      <main class="main">
        {{ content_for_layout }}
      </main>

    </div>

    <div class="cart-overlay" id="cartOverlay"></div>

    <div class="cart-drawer" id="cartDrawer">
      <div class="cart-drawer-header">
        <span>CART [<span id="cartCount">{{ cart.item_count }}</span>]</span>
        <button class="cart-close" id="cartClose"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <div class="cart-drawer-items" id="cartItems">
        {% if cart.item_count == 0 %}
          <p class="cart-empty">"YOUR BAG IS EMPTY"</p>
          <p class="cart-empty alt-lang">ਤੁਹਾਡਾ ਬੈਗ ਖਾਲੀ ਹੈ।</p>
          <p class="cart-empty alt-lang">حقيبتك فارغة</p>
        {% else %}
          {% for item in cart.items %}
            <div class="cart-item" data-key="{{ item.key }}">
              <div class="cart-item-image">
                <img src="{{ item.image | img_url: 'small' }}" alt="{{ item.title }}" />
              </div>
              <div class="cart-item-info">
                <div class="cart-item-name">{{ item.product.title }}</div>
                {% unless item.variant.title == 'Default Title' %}
                  <div class="cart-item-variant">{{ item.variant.title }}</div>
                {% endunless %}
                <div class="cart-item-price">{{ item.price | money_without_currency }} USD</div>
                <div class="cart-item-qty">
                  <button class="qty-btn" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}">−</button>
                  <span>{{ item.quantity }}</span>
                  <button class="qty-btn" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}">+</button>
                </div>
              </div>
              <button class="cart-item-remove" data-key="{{ item.key }}"><i class="fa-solid fa-xmark"></i></button>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <div class="cart-drawer-footer">
        <div class="cart-subtotal">
          <span>SUBTOTAL</span>
          <span id="cartSubtotal">{{ cart.total_price | money_without_currency }} USD</span>
        </div>
        <a href="/checkout" class="cart-checkout-btn">CHECKOUT</a>
      </div>
    </div>

    {{ 'app.js' | asset_url | script_tag }}
  </body>
</html>